PORT=3000
NODE_ENV=development
IS_LOCAL=true
LOG_LEVEL=debug

# PostgreSQL
DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5432/homelab_db"
DATABASE_HOST="localhost"
DATABASE_PORT=5432
DATABASE_USER="postgres"
DATABASE_PASSWORD="your_postgres_password"
DATABASE_NAME="homelab_db"

# MinIO
MINIO_ENDPOINT="https://s3.homelab.local"
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY="admin"
MINIO_SECRET_KEY="your_minio_secret_key"
MINIO_BUCKET_DOCS="my-space-markdown"
MINIO_BUCKET_ASSETS="my-space-assets"
MINIO_REGION="us-east-1"
MINIO_FORCE_PATH_STYLE=true

# OpenSearch
OPENSEARCH_NODE="https://opensearch.homelab.local"
OPENSEARCH_USERNAME="admin"
OPENSEARCH_PASSWORD="your_opensearch_password"
OPENSEARCH_REJECT_UNAUTHORIZED=false

# RabbitMQ (마크다운 인덱싱 이벤트 발행)
RABBITMQ_URL="amqp://admin:your_rabbitmq_password@localhost:5672"
RABBITMQ_INDEXING_QUEUE="markdown-indexing-queue"
