# ==========================================
# My Space Backend - Environment Variables Template
# ==========================================

# 서버 포트 (기본값: 3000)
PORT=3000

# 실행 환경 (development | production | test)
NODE_ENV=development

# 로컬 개발 환경 여부 (true일 때 들여쓰기 프리티 JSON 로깅 및 스택 트레이스 노출)
IS_LOCAL=true

# 로그 레벨 (debug | info | warn | error, 미지정 시 IS_LOCAL=true면 debug, false면 info)
LOG_LEVEL=debug

# ==============================================================================
# Database (PostgreSQL)
# ==============================================================================
DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5432/homelab_db"
DATABASE_HOST="localhost"
DATABASE_PORT=5432
DATABASE_USER="postgres"
DATABASE_PASSWORD="your_postgres_password"
DATABASE_NAME="homelab_db"

# ==============================================================================
# Object Storage (MinIO)
# - S3 API 엔드포인트: https://s3.homelab.local (로컬 Ingress) 또는 http://localhost:9000
# - @aws-sdk/client-s3 사용 시 MINIO_REGION, MINIO_FORCE_PATH_STYLE 필요
# - minio 전용 npm 패키지 사용 시 ENDPOINT, ACCESS_KEY, SECRET_KEY 위주로 사용
# ==============================================================================
MINIO_ENDPOINT="https://s3.homelab.local"
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY="admin"
MINIO_SECRET_KEY="your_minio_root_password"
MINIO_BUCKET_DOCS="my-space-markdown"
MINIO_BUCKET_ASSETS="my-space-assets"
MINIO_REGION="us-east-1"
MINIO_FORCE_PATH_STYLE=true

# ==============================================================================
# Search Engine (OpenSearch)
# ==============================================================================
OPENSEARCH_NODE="https://opensearch.homelab.local"
OPENSEARCH_USERNAME="admin"
OPENSEARCH_PASSWORD="your_opensearch_password"
OPENSEARCH_REJECT_UNAUTHORIZED=false
