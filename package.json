  "type": "module",
  "scripts": {
    "build": "nest build api && nest build ai",
    "build:api": "nest build api",
    "build:ai": "nest build ai",
    "start:api": "nest start api",
    "start:api:dev": "IS_LOCAL=true nest start api --watch",
    "start:api:debug": "IS_LOCAL=true nest start api --debug --watch",
    "start:api:prod": "node dist/apps/api/main.js",
    "start:ai": "nest start ai",
    "start:ai:dev": "IS_LOCAL=true PORT=3001 nest start ai --watch",
    "start:ai:debug": "IS_LOCAL=true PORT=3001 nest start ai --debug --watch",
    "start:ai:prod": "node dist/apps/ai/main.js",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"test/**/*.ts\"",
    "lint": "oxlint apps/ libs/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
