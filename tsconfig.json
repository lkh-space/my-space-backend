{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@app/common": ["./libs/common/src/index.ts"],
      "@app/common/*": ["./libs/common/src/*"],
      "@app/storage": ["./libs/storage/src/index.ts"],
      "@app/storage/*": ["./libs/storage/src/*"],
      "@app/config": ["./libs/config/src/index.ts"],
      "@app/config/*": ["./libs/config/src/*"],
      "@app/markdown-core": ["./libs/markdown-core/src/index.ts"],
      "@app/markdown-core/*": ["./libs/markdown-core/src/*"]
    },
    "types": ["vitest/globals", "node", "multer"]
  }
}
