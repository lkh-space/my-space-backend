PORT=3001
NODE_ENV=development
IS_LOCAL=true
LOG_LEVEL=debug

# PostgreSQL (Prisma 마크다운 문서 읽기/저장 도구용)
DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5432/homelab_db"

# MinIO (마크다운 원문 스트리밍 및 인덱싱용)
MINIO_ENDPOINT="https://s3.homelab.local"
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY="admin"
MINIO_SECRET_KEY="your_minio_secret_key"
MINIO_BUCKET_DOCS="my-space-markdown"
MINIO_REGION="us-east-1"
MINIO_FORCE_PATH_STYLE=true

# Google Gemini
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Ollama
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3.5:0.8b"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# Qdrant (벡터 검색 DB)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY="your_qdrant_api_key_here"
QDRANT_COLLECTION="personal-documents"

# RabbitMQ (마크다운 인덱싱 큐 수신 및 저장 이벤트 발행)
RABBITMQ_URL="amqp://admin:your_rabbitmq_password@localhost:5672"
RABBITMQ_INDEXING_QUEUE="markdown-indexing-queue"
